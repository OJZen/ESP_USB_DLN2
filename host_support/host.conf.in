# ESP USB DLN2 host support configuration.

ESP_USB_DLN2_ACCESS_GROUP=@ACCESS_GROUP@
ESP_USB_DLN2_DEV_MODE=0660

# SPI child created on the Linux DLN2 SPI master.
ESP_USB_DLN2_SPI_BUS=auto
ESP_USB_DLN2_SPI_CS=0
ESP_USB_DLN2_SPI_MAX_SPEED_HZ=100000
ESP_USB_DLN2_SPI_MODE=0
ESP_USB_DLN2_SPI_MODALIAS=dh2228fv
ESP_USB_DLN2_SPI_MODULE=@SPI_MODULE@
